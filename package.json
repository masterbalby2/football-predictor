{
  "name": "football-predictor",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered football match predictor using Dixon-Coles Poisson model with recent-form adjustment. EPL, La Liga, Bundesliga predictions with win/draw/loss probabilities, scoreline forecasts, and confidence-rated tips.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev:api": "pnpm --filter @soccer/api run dev",
    "dev:web": "pnpm --filter @soccer/web run dev",
    "dev:bot": "pnpm --filter @soccer/bot run dev",
    "cron:run": "pnpm --filter @soccer/cron run start",
    "db:migrate": "pnpm --filter @soccer/db run migrate",
    "db:setup": "pnpm --filter @soccer/db run setup"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
