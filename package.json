{
  "name": "soccer-predictor",
  "version": "0.1.0",
  "private": true,
  "description": "Dixon-Coles EPL/La Liga/Bundesliga match predictor (web + Telegram bot)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev:api": "pnpm --filter @soccer/api run dev",
    "dev:web": "pnpm --filter @soccer/web run dev",
    "dev:bot": "pnpm --filter @soccer/bot run dev",
    "cron:run": "pnpm --filter @soccer/cron run start",
    "db:migrate": "pnpm --filter @soccer/db run migrate",
    "db:setup": "pnpm --filter @soccer/db run setup"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
