# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soccer
# Run migrations on boot (api/cron). Set to false in prod if you migrate separately.
DB_RUN_MIGRATIONS=true

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Data source ----
# football-data.org API token (https://www.football-data.org/client/register)
# Optional: without it the app runs on seed data.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# ---- Model (Dixon-Coles) ----
DC_DELTA=0.011
DC_HALF_LIFE_DAYS=540
DC_RIDGE_LAMBDA=0.002
DC_MAX_GOALS=10
DC_MIN_MATCHES=20

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed origins (CORS)
API_CORS_ORIGIN=http://localhost:3000

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Telegram bot ----
# Optional: bot runs in dry-run mode (no polling) when absent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_OWNER_CHAT_ID=
# Hour (UTC) to push the daily digest
TELEGRAM_DIGEST_HOUR_UTC=7

# ---- Cron ----
# When run as a one-shot (Railway cron), exits after refresh.
CRON_ONE_SHOT=true
CRON_LOG_LEVEL=info
