# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soccer
# Run migrations on boot (api/cron). Set to false in prod if you migrate separately.
DB_RUN_MIGRATIONS=true

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Data source ----
# football-data.org API token (https://www.football-data.org/client/register)
# Required: the app fetches real match data from this API.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# ---- Model (Dixon-Coles) ----
MODEL_VERSION=DC-1
DC_DELTA=0.15
DC_HALF_LIFE_DAYS=365
DC_RIDGE_LAMBDA=0
DC_MAX_GOALS=10
DC_MIN_MATCHES=20
# Recent-form adjustment: weight given to last-N-matches form vs. season strength.
# 0 = pure Dixon-Coles (season-long only). 0.2 = 20% form, 80% season strength.
DC_FORM_WEIGHT=0.2
# Number of most-recent matches used to compute the form factor.
DC_FORM_RECENT_N=6

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed origins (CORS)
API_CORS_ORIGIN=http://localhost:3000
# Bearer token for API auth. If empty, API is open (dev only).
# The web frontend sends this automatically via a server-side proxy.
API_AUTH_TOKEN=

# ---- Web (Auth) ----
# Credentials for the web frontend login page.
# Change these in production!
AUTH_USERNAME=admin
AUTH_PASSWORD=predictor123
# Secret used to sign session cookies. Generate a strong random string.
AUTH_SECRET=dev-secret-change-in-production

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Telegram bot ----
# Optional: bot runs in dry-run mode (no polling) when absent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_OWNER_CHAT_ID=
# Hour (UTC) to push the daily digest
TELEGRAM_DIGEST_HOUR_UTC=7

# ---- Cron ----
# When run as a one-shot (Railway cron), exits after refresh.
CRON_ONE_SHOT=true
CRON_LOG_LEVEL=info
# TTL (seconds) for the cron lock to prevent overlapping runs
CRON_LOCK_TTL_SECONDS=600
